[
  {
    "id": 1,
    "name": "과도한 쉼표 사용",
    "severity": "S2",
    "kind": "metric",
    "metric": "comma_sentence_ratio",
    "bound": {
      "gt": 0.4
    },
    "guidance": "쉼표 없이 읽히는 자리의 쉼표를 지우고, 긴 문장은 마침표로 나눈다."
  },
  {
    "id": 3,
    "name": "연결어미 뒤 쉼표",
    "severity": "S2",
    "kind": "regex",
    "pattern": "(?:(?<!그리)(?<!그러)[가-힣](?:면서|으며|지만|는데|고|며)|(?<![에게로])[가-힣]서)\\s*,",
    "threshold": {
      "scope": "document",
      "count": 3
    },
    "autofix": [
      {
        "pattern": "([가-힣](?:아서|어서|여서|해서|나서|가서|와서|봐서|돼서|줘서|써서|면서|으며|지만|는데)|하고|되고|있고|없고|이고|하며|되며|이며)\\s*,\\s*",
        "replacement": "\\1 "
      }
    ],
    "guidance": "연결어미가 이미 절 관계를 나타내므로 뒤따르는 쉼표를 지운다. 자동 교정은 동사 어미가 분명한 형태만 다룬다."
  },
  {
    "id": 4,
    "name": "접속부사 앞 쉼표",
    "severity": "S2",
    "kind": "regex",
    "pattern": ",\\s*(?:그리고|하지만|그러나|따라서|또한|게다가|그러므로|즉)\\s",
    "threshold": {
      "scope": "document",
      "count": 1
    },
    "guidance": "쉼표를 마침표로 바꾸고 접속부사가 새 문장을 열게 한다."
  },
  {
    "id": 5,
    "name": "불필요한 목록 쉼표",
    "severity": "S3",
    "kind": "regex",
    "pattern": "[가-힣]{1,6},\\s*[가-힣]{1,6},\\s*[가-힣]{1,6}(?:을|를|이|가|은|는)",
    "threshold": {
      "scope": "document",
      "count": 1
    },
    "guidance": "짧은 목록은 첫 쌍을 와/과로 잇거나 띄어쓰기만 남긴다."
  },
  {
    "id": 6,
    "name": "줄표 과다 사용",
    "severity": "S2",
    "kind": "regex",
    "pattern": "(?<=\\s)—(?=\\s)",
    "threshold": {
      "scope": "document",
      "count": 1
    },
    "autofix": [
      {
        "pattern": "\\s—\\s([^—\\n|]+?)\\s—\\s",
        "replacement": " (\\1) "
      }
    ],
    "guidance": "쌍으로 쓰인 줄표는 괄호로, 홀로 쓰인 줄표는 문장 나누기로 바꾼다. 숫자 범위의 en-dash는 올바른 표기이므로 대상이 아니다."
  },
  {
    "id": 7,
    "name": "영어식 콜론 과다 사용",
    "severity": "S2",
    "kind": "regex",
    "pattern": "[가-힣]\\s*:\\s*$",
    "threshold": {
      "scope": "document",
      "count": 1
    },
    "autofix": [
      {
        "pattern": "((?:습니다|입니다|합니다))\\s*:\\s*$",
        "replacement": "\\1."
      },
      {
        "pattern": "^(\\s*(?:\\*\\*)?[가-힣][가-힣 ]{0,10}(?:\\*\\*)?)\\s*:\\s*$",
        "replacement": "\\1"
      }
    ],
    "guidance": "도입부 콜론을 마침표로 바꾸거나 지운다. 시간·비율 표기는 예외다."
  }
]
